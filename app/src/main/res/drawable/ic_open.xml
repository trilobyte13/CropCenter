<?xml version="1.0" encoding="utf-8"?>
<!--
    Open (upward arrow + base bar) toolbar icon — Material Design "file_upload" glyph.
    Custom vector drawable rather than `@android:drawable/ic_menu_upload` so the four toolbar
    icons share the same Material stroke weight + 24dp viewport. The Material file_upload
    glyph is also a cleaner read at small sizes than the older Holo upload arrow. Tintable
    via the layout's `app:tint` attribute.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M9,16h6v-6h4l-7,-7 -7,7h4zM5,18h14v2H5z" />
</vector>
