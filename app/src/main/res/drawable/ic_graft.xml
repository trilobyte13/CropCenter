<?xml version="1.0" encoding="utf-8"?>
<!--
    Graft icon — Material Design "call_merge" glyph (two paths converging into one with an
    upward arrow head). Chosen for the graft / apply-external-edit toolbar action because the
    Y-shape literally depicts "merge two things into one" — the loaded image + the external edit
    combine into the resulting in-memory bitmap. Standard 24dp viewport so it visually matches
    the size of the surrounding `@android:drawable/ic_menu_*` icons (Settings / Open / Save).
    Tintable: the white fillColor is replaced by the layout's `app:tint` attribute at render time.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
