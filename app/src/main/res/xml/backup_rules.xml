<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup rules for Android 11 and below. Excludes external storage (where the streaming-pipeline
  cache holds partial HDR / JPEG / PNG tempfiles mid-save) and the two SharedPreferences files that
  record per-install pointers (last save folder, picker view mode). The pointers are device-local
  nicety and shouldn't flow to another install via cloud restore. SaveController.PREFS_NAME =
  "cropcenter_save", FolderPickerDialog.PREFS_NAME = "cropcenter_picker_view". The grid/list toggle
  and last-save-folder rebuild themselves on first use. Internal cache (getCacheDir() — where
  input_raw_* and hdr_src_* tempfiles live) is excluded by Auto Backup's defaults, so we don't list
  it here — and the lint-accepted backup-content domain set doesn't include "cache" / "external_cache"
  anyway (FullBackupContent rejects them outright).
-->
<full-backup-content>
    <exclude domain="external" path="." />
    <exclude domain="sharedpref" path="cropcenter_save.xml" />
    <exclude domain="sharedpref" path="cropcenter_picker_view.xml" />
</full-backup-content>
