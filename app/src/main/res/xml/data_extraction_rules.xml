<?xml version="1.0" encoding="utf-8"?>
<!--
  Data extraction rules: exclude the two per-install SharedPreferences files from both cloud
  backup and device transfer. The SharedPreferences hold device-local nicety pointers (last save
  folder, grid/list toggle) that shouldn't flow to a different install. The "external" domain
  exclusion is defensive — the streaming-pipeline scratch lives in getCacheDir() (internal cache,
  excluded by default) and the in-place save tempfiles are written directly into the user's
  chosen public output folder (NOT under getExternalFilesDir(), so the "external" domain doesn't
  cover them anyway). Kept here in case a future code change reroutes any scratch path into
  getExternalFilesDir(); cheap defence-in-depth. Internal cache isn't listable explicitly because
  the lint-accepted domain set has no "cache" / "external_cache" entry.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="external" path="." />
        <exclude domain="sharedpref" path="cropcenter_save.xml" />
        <exclude domain="sharedpref" path="cropcenter_picker_view.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="external" path="." />
        <exclude domain="sharedpref" path="cropcenter_save.xml" />
        <exclude domain="sharedpref" path="cropcenter_picker_view.xml" />
    </device-transfer>
</data-extraction-rules>
